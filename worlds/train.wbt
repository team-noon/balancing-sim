#VRML_SIM R2025a utf8

EXTERNPROTO "https://raw.githubusercontent.com/cyberbotics/webots/R2025a/projects/objects/floors/protos/RectangleArena.proto"
EXTERNPROTO "../protos/noonRobot.proto"
EXTERNPROTO "../protos/noonRobotSpawner.proto"
DEF WorldInfo WorldInfo {
  basicTimeStep 16
  physicsDisableLinearThreshold 0.005
  physicsDisableAngularThreshold 0.005
  contactProperties [
    ContactProperties {
      material2 "floor"
      coulombFriction [
        0.8, 0.6
      ]
      frictionRotation 0 0
      rollingFriction 0.01 
      bounce 0.05
      bounceVelocity 0.2
      forceDependentSlip [
        0.02
      ]
    }
  ]
}

RectangleArena {
  contactMaterial "floor"
  floorSize 200 200
  floorTileSize 1 1
  floorAppearance NULL
}
noonRobot {
  controller "<extern>"
  name "trainer"
}
DEF TRAINER noonRobotSpawner {
  count 0
  spacing 30
}
